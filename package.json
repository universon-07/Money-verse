    "preview": "vite preview",
    "art": "python tools/import_art.py",
    "check:tokens": "node tools/check-tokens.mjs",
    "test": "vitest run",
    "p4:validate": "node --experimental-strip-types --no-warnings tools/p4-validate.mjs",
