    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "easystarjs": "^0.4.4",
    "framer-motion": "^14.1.0",
    "i18next": "^26.4.3",
    "pptxgenjs": "^3.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
